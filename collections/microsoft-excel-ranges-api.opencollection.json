{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph Excel Charts Ranges API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Ranges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Excel Get Range",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/me/drive/items/:item-id/workbook/worksheets/:worksheet-id-or-name/range(address=':address')",
            "headers": [
              {
                "name": "workbook-session-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "item-id",
                "value": "",
                "type": "path",
                "description": "The ID of the workbook file."
              },
              {
                "name": "worksheet-id-or-name",
                "value": "",
                "type": "path",
                "description": "Worksheet ID or name."
              },
              {
                "name": "address",
                "value": "A1:B2",
                "type": "path",
                "description": "Cell range address in A1 notation."
              }
            ]
          },
          "docs": "Retrieve a range of cells from the worksheet."
        },
        {
          "info": {
            "name": "Microsoft Excel Update Range",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://graph.microsoft.com/v1.0/me/drive/items/:item-id/workbook/worksheets/:worksheet-id-or-name/range(address=':address')",
            "headers": [
              {
                "name": "workbook-session-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "item-id",
                "value": "",
                "type": "path",
                "description": "The ID of the workbook file."
              },
              {
                "name": "worksheet-id-or-name",
                "value": "",
                "type": "path",
                "description": "Worksheet ID or name."
              },
              {
                "name": "address",
                "value": "A1:B2",
                "type": "path",
                "description": "Cell range address in A1 notation."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update values, formulas, or number format of a cell range."
        }
      ]
    }
  ],
  "bundled": true
}