{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph Excel Charts Sessions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Excel Create Workbook Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://graph.microsoft.com/v1.0/me/drive/items/:item-id/workbook/createSession",
            "params": [
              {
                "name": "item-id",
                "value": "",
                "type": "path",
                "description": "The ID of the workbook file in OneDrive."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new workbook session with optional persistence."
        }
      ]
    }
  ],
  "bundled": true
}